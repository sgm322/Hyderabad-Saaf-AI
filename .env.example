# ============================================================
# AI KEYS  (required for real AI; app still demos without them)
# ============================================================
# Hugging Face token: https://huggingface.co/settings/tokens
# Create a "Read" token. Vision model is called DIRECTLY from the browser.
NEXT_PUBLIC_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini key: https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GEMINI_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional overrides
NEXT_PUBLIC_HF_VISION_MODEL=google/vit-base-patch16-224
NEXT_PUBLIC_GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# FIREBASE (optional - falls back to local realtime store)
# Firebase Console > Project settings > Your apps > Web app
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
